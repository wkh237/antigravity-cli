{
  "in-flight-steering": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/steer_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "./scripts/steer_hook.py",
        "timeout": 5
      }
    ]
  }
}
